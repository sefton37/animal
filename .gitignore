__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
node_modules/
dist/
build/
target/
Cargo.lock.orig

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/
